# EnterpriseAI-OS Environment Configuration
# نسخ هذه الملف إلى .env وعدل القيم

# === Application ===
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string

# === Database ===
DATABASE_URL=postgresql://enterpriseai:secure_password@postgres:5432/enterpriseai
DB_PASSWORD=secure_password

# === Cache ===
REDIS_URL=redis://redis:6379/0

# === Analytics ===
CLICKHOUSE_URL=clickhouse://localhost:8123/enterpriseai

# === Message Broker ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === AI ===
AI_GPU_ENABLED=false
AI_MODEL_PATH=/models
# إصلاح: أسماء النماذج الحالية في تعريفات الوكلاء ليست نماذج حقيقية على Hugging Face Hub؛
# اتركه false حتى تتوفر نماذج مدرَّبة فعلية بأسماء صحيحة (راجع core/config.py)
MODEL_LOADING_ENABLED=false

# === Security ===
# تشديد أمني حرج: القيم أدناه *يجب* تغييرها لكل نشر/عميل - core/config.py يرفض
# الإقلاع فورًا في ENVIRONMENT=production إن بقيت بقيمتها الافتراضية أو أقل من 32
# حرفًا (راجع validate_production_secrets). لا تنسخ هذا الملف كما هو لأي عميل -
# scripts/setup.sh يولّد قيمًا عشوائية فريدة تلقائيًا عبر openssl عند أول تشغيل.
JWT_SECRET=change-this-to-another-secure-random-string
ENCRYPTION_KEY=change-this-to-a-32-byte-encryption-key

# مدة صلاحية رمز الوصول بالساعات (افتراضي: ساعتان - قصير عمدًا لتقليل نافذة
# الاستغلال لو سُرِق التوكن؛ يُعتمَد على JWT_REFRESH_EXPIRY_DAYS + /auth/refresh
# لتجربة استخدام متواصلة بلا إعادة تسجيل دخول متكررة)
JWT_EXPIRY_HOURS=2
JWT_REFRESH_EXPIRY_DAYS=7

# حماية القوة الغاشمة (brute force) على تسجيل الدخول تحديدًا - بالإضافة لحد
# الطلبات العام (RATE_LIMIT_REQUESTS) لكل الـ API
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=60
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# === CORS / Hosts ===
# تشديد أمني: حدِّد نطاقات حقيقية هنا لأي نشر إنتاجي - القيم الافتراضية في الكود
# (core/config.py) للتطوير المحلي فقط ("*" لـALLOWED_HOSTS، وlocalhost لـ
# ALLOWED_ORIGINS) ولا تصلح لعميل حقيقي.
ALLOWED_HOSTS=api.yourcompany.com,yourcompany.com
ALLOWED_ORIGINS=https://app.yourcompany.com

# === Monitoring ===
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# === Email ===
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=noreply@company.com
SMTP_PASSWORD=
